[configuration]
entry_symbol = "botf_core_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://core/bin/libbotf_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://core/bin/libbotf_core.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://core/bin/libbotf_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://core/bin/libbotf_core.windows.template_release.x86_64.dll"
