extends Node
## Entry point: checks the core extension, then mounts the strategic UI shell.

## Web smoothness pass (19 Nov 2026): the browser runs the game on one thread, so the boot used to compile every script the
## title needs, build the shell and draw the title in a single frame of several seconds. On the web a plain "Starting" panel
## shows first, the game's scripts are compiled a few per frame behind it (BOOT_BUDGET_USEC each frame), and only then is the
## shell mounted (App splits its own start-up over frames too). Desktop boots as before.
const BOOT_BUDGET_USEC := 30000
var _boot_panel: CanvasLayer = null

func _web_boot() -> void:
	var tree := get_tree()
	var layer := CanvasLayer.new()
	layer.layer = 100
	var bg := ColorRect.new()
	bg.color = Color(0.02, 0.027, 0.06)
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	var label := Label.new()
	label.text = "Starting BOTF Remastered"
	label.set_anchors_preset(Control.PRESET_CENTER)
	label.grow_horizontal = Control.GROW_DIRECTION_BOTH
	label.grow_vertical = Control.GROW_DIRECTION_BOTH
	label.add_theme_font_size_override("font_size", 28)
	label.add_theme_color_override("font_color", Color(0.81, 0.88, 1.0))
	bg.add_child(label)
	layer.add_child(bg)
	add_child(layer)
	_boot_panel = layer
	for _i in 2:
		await tree.process_frame # the panel is on screen before any loading starts
	# WebGPU round 7: dependencies first (scripts/boot_order.gd, generated by remaster/tools/web/gen_boot_order.py). A load
	# compiles everything the script references that is not compiled yet, so galaxy_map.gd first was one 450-550 ms frame.
	var paths: Array = []
	var listed := {}
	for p: String in (load("res://scripts/boot_order.gd") as GDScript).get_script_constant_map().get("ORDER", PackedStringArray()):
		paths.append(p)
		listed[p] = true
	for c in ProjectSettings.get_global_class_list():
		var p := str(c.get("path", ""))
		if p.ends_with(".gd") and not p.contains("/tests/") and not p.contains("/tools/") and not p.begins_with("res://core/") and not listed.has(p):
			paths.append(p)
	var t0 := Time.get_ticks_usec()
	var n := 0
	for p: String in paths:
		var t := LoadTrace.start()
		if ResourceLoader.exists(p):
			_boot_refs.append(load(p))
		LoadTrace.done("boot: compile %s" % p.get_file(), t, 60)
		n += 1
		if Time.get_ticks_usec() - t0 >= BOOT_BUDGET_USEC:
			label.text = "Starting BOTF Remastered (%d%%)" % (100 * n / maxi(paths.size(), 1))
			_boot_text("Loading the game (%d%%)" % (100 * n / maxi(paths.size(), 1)))
			await tree.process_frame
			t0 = Time.get_ticks_usec()
	await tree.process_frame
	# WebGPU round 6: the game's shaders compile one per frame here, behind the panel, not all in the title's first frame.
	# Loaded by path, not named: naming ShaderWarm here made main.gd (compiled at engine start, before this panel exists)
	# compile ShaderWarm and the battle scripts it names in the engine's first frames (WebGPU round 7).
	var warm: GDScript = load("res://scripts/shader_warm.gd")
	if warm.needed():
		await warm.run(self, func(d: int, total: int) -> void:
			label.text = "Preparing graphics (%d%%)" % (100 * d / maxi(total, 1))
			_boot_text(label.text))

## Web: the HTML loading screen's progress line.
static func _boot_text(t: String) -> void:
	JavaScriptBridge.eval("globalThis.botfBootText && globalThis.botfBootText(%s)" % JSON.stringify(t))

static var _boot_refs: Array = []   ## the compiled scripts stay loaded (the game uses them all)

func _ready() -> void:
	if Engine.has_singleton("BotfCore"):
		var meta: Dictionary = BotfCore.request("meta")
		print("BOTF Remastered (Godot) booting: core ok=%s, %d empires" % [meta.ok, meta.result.empires.size()])
	else:
		push_warning("BotfCore extension not loaded (build it with core/build.sh); using recorded fixtures")
	if DisplayServer.get_name() == "headless" and OS.get_cmdline_user_args().has("--boot-check"):
		get_tree().quit()
		return
	if OS.has_feature("web"):
		await _web_boot()
	var t_boot := LoadTrace.start()
	var app_scene: Node = load("res://scenes/ui/app.tscn").instantiate()
	t_boot = LoadTrace.done("boot: app scene load", t_boot)
	add_child(app_scene)
	LoadTrace.done("boot: app ready (total)", t_boot)
	if _boot_panel != null:
		_boot_panel.queue_free()
		_boot_panel = null
	if OS.has_feature("web"):
		# WebGPU round 8: the HTML loading screen (export preset head_include) stays over the canvas from the page's first
		# paint until the title has drawn two frames, so the browser never shows a frozen game frame while the engine starts
		# and the shaders compile. Its spinner is a CSS animation, which the browser keeps turning while the page is busy.
		# App builds the title over its own next frames (App._ready awaits), so wait for the title screen to exist first.
		for _i in 600:
			if str(app_scene.get("screen")) == "title":
				break
			await get_tree().process_frame
		for _i in 2:
			await get_tree().process_frame
		JavaScriptBridge.eval("globalThis.botfBootDone && globalThis.botfBootDone()")
	print("BOTF title up")   # WebGPU round 8: the verify drivers wait for this (Preparing graphics is over, the title is drawn)
	if AppLoader.diag():
		var t := Timer.new()
		t.wait_time = 5.0
		t.autostart = true
		t.timeout.connect(func() -> void:
			var ri := RenderingServer
			print("DIAG gpu tex=%.0f MB buf=%.0f MB video=%.0f MB draw=%d objs=%d nodes=%d" % [
				ri.get_rendering_info(RenderingServer.RENDERING_INFO_TEXTURE_MEM_USED) / 1048576.0,
				ri.get_rendering_info(RenderingServer.RENDERING_INFO_BUFFER_MEM_USED) / 1048576.0,
				ri.get_rendering_info(RenderingServer.RENDERING_INFO_VIDEO_MEM_USED) / 1048576.0,
				ri.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME),
				ri.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_OBJECTS_IN_FRAME),
				get_tree().get_node_count()]))
		add_child(t)
