# BOTF Remastered web build: Apache (mod_mime, mod_headers, mod_rewrite). Upload the folder as it is; this file goes with it.
# Remove the whole file if your host refuses .htaccess and set the same rules in its panel (see HOSTING.md).

AddType application/wasm .wasm
AddType application/octet-stream .pck
AddType text/javascript .js
AddType application/json .json

# Precompressed sidecars: index.js.br / index.wasm.gz and so on are served in place of the plain file when the browser accepts
# them. index.pck (the game's own data, not a pack) is served this way too. The downloaded packs (packs/*.pck) are never compressed: Godot's downloader cannot take a content-encoded body.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Accept-Encoding} br
RewriteCond %{REQUEST_FILENAME}.br -f
RewriteRule ^((?:index\.pck)|.+\.(?:js|wasm|html))$ $1.br [L,QSA,E=BOTF_BR:1]
RewriteCond %{HTTP:Accept-Encoding} gzip
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^((?:index\.pck)|.+\.(?:js|wasm|html))$ $1.gz [L,QSA,E=BOTF_GZ:1]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "(\.(js|wasm|html)|^index\.pck)\.br$">
  Header set Content-Encoding br
  Header append Vary Accept-Encoding
</FilesMatch>
<FilesMatch "(\.(js|wasm|html)|^index\.pck)\.gz$">
  Header set Content-Encoding gzip
  Header append Vary Accept-Encoding
</FilesMatch>
<FilesMatch "\.wasm\.(br|gz)$">
  ForceType application/wasm
</FilesMatch>
<FilesMatch "\.js\.(br|gz)$">
  ForceType text/javascript
</FilesMatch>
<FilesMatch "\.html\.(br|gz)$">
  ForceType text/html
</FilesMatch>
<FilesMatch "^index\.pck\.(br|gz)$">
  ForceType application/octet-stream
</FilesMatch>
# Content-hashed packs never change under their name: keep them a year. Everything else is revalidated (a 304 costs nothing).
<FilesMatch "\.[0-9a-f]{12}\.pck$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "^(index\..*|manifest\.json|sizes\.json)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
