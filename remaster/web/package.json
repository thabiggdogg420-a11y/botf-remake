{
  "name": "botf-remastered-web",
  "private": true,
  "version": "0.1.0",
  "description": "BOTF Remastered browser client: the deterministic C++ simulation core in WebAssembly with a Preact UI.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "wasm": "bash ./build-wasm.sh",
    "test": "node test/bridge.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/antonio": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
