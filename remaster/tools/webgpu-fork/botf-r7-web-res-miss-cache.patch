@@ -42,6 +42,36 @@
 #include "core/os/os.h"
 #include "core/os/time.h"
 
+#ifdef WEB_ENABLED
+// BOTF web round 7: an exported web game has res:// only in its mounted packs, and the engine probes res:// for files
+// that are not there all the time (.remap, .import, .gdc and uid variants while scripts compile and resources load).
+// Each miss falls through to the Emscripten file system, whose path lookup throws a JS exception per missing file:
+// about 30% of the boot's script-compile frames. A res:// path that was not found once is remembered as missing;
+// a hit is never cached, so a file that does exist on disk (GDExtension side modules) still loads.
+#include "core/os/mutex.h"
+#include "core/templates/hash_set.h"
+static HashSet<String> web_res_missing;
+static Mutex web_res_missing_mutex;
+static bool _web_res_known_missing(const String &p_path) {
+	if (!p_path.begins_with("res://")) {
+		return false;
+	}
+	MutexLock lock(web_res_missing_mutex);
+	return web_res_missing.has(p_path);
+}
+static void _web_res_note_missing(const String &p_path) {
+	if (!p_path.begins_with("res://")) {
+		return;
+	}
+	static const bool exported = OS::get_singleton() && OS::get_singleton()->has_feature("template");
+	if (!exported) {
+		return;
+	}
+	MutexLock lock(web_res_missing_mutex);
+	web_res_missing.insert(p_path);
+}
+#endif
+
